NUXEO_RETENTION_VERSION=2025.4-SNAPSHOT
NUXEO_VERSION=2025.22-SNAPSHOT
NUXEO_PACKAGES=nuxeo-web-ui
NUXEO_DEV_MODE=true
NUXEO_CLID=

# task deploy: the <server> id in ~/.m2/settings.xml holding the credentials, and where releases and
# -SNAPSHOT versions go (the same URL when the repository takes both)
DISTRIBUTION_ID=
DISTRIBUTION_URL=
DISTRIBUTION_SNAPSHOTS_URL=

JAVA_VERSION=21-tem
# Maven settings (MVN_*): tracked defaults in .env.mvn; set one here to override it. Listed in taskfiles/mvn.yml.
